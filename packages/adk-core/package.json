{
  "name": "@kassis/adk-core",
  "version": "0.2.0",
  "type": "module",
  "description": "Command library for kassis-addon and kassis-adk-mcp. Returns results; callers handle printing and exit codes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis-adk.git",
    "directory": "packages/adk-core"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mandatory-contract": {
      "types": "./src/engine/mandatoryContract.d.mts",
      "default": "./src/engine/mandatoryContract.mjs"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./cli/kassis-addon": "./src/cli/kassis-addon.mjs",
    "./cli/kassis-adk-mcp": "./src/cli/kassis-adk-mcp.mjs",
    "./profiles/addon-coding-agent.json": "./profiles/addon-coding-agent.json",
    "./profiles/addon-coding-agent.v1.json": "./profiles/addon-coding-agent.v1.json",
    "./profiles/addon-coding-agent.v3.draft.json": "./profiles/addon-coding-agent.v3.draft.json"
  },
  "files": [
    "dist",
    "keys",
    "profiles",
    "trust"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node ../../tools/adk/pack-session.mjs begin \"npm run build && node ../../tools/adk/pack-publish-fields.mjs apply\"",
    "postpack": "node ../../tools/adk/pack-session.mjs end \"node ../../tools/adk/pack-publish-fields.mjs restore\""
  },
  "dependencies": {
    "@kassis/addon-sdk": "0.2.0",
    "@kassis/addon-testkit": "0.2.0",
    "@kassis/adk-protocol": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./mandatory-contract": {
        "types": "./dist/engine/mandatoryContract.d.mts",
        "import": "./dist/engine/mandatoryContract.mjs",
        "default": "./dist/engine/mandatoryContract.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js",
        "default": "./dist/testing.js"
      },
      "./profiles/addon-coding-agent.json": "./profiles/addon-coding-agent.json",
      "./profiles/addon-coding-agent.v1.json": "./profiles/addon-coding-agent.v1.json",
      "./profiles/addon-coding-agent.v3.draft.json": "./profiles/addon-coding-agent.v3.draft.json"
    }
  }
}
