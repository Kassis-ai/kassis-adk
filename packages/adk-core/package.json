{
  "name": "@kassis/adk-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Command library for kassis-addon and kassis-adk-mcp. Returns results; callers handle printing and exit codes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis.git",
    "directory": "packages/adk-core"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/pack-publish-fields.mjs apply",
    "postpack": "node ../../scripts/pack-publish-fields.mjs restore"
  },
  "dependencies": {
    "@kassis/addon-sdk": "0.1.0",
    "@kassis/addon-testkit": "0.1.0",
    "@kassis/adk-protocol": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "provenance": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "import": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  }
}
