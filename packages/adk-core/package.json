{
  "name": "@kassis/adk-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Command library for kassis-addon and kassis-adk-mcp. Returns results; callers handle printing and exit codes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis.git",
    "directory": "packages/adk-core"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mandatory-contract": {
      "types": "./src/engine/mandatoryContract.d.mts",
      "default": "./src/engine/mandatoryContract.mjs"
    },
    "./cli/kassis-addon": "./src/cli/kassis-addon.mjs",
    "./cli/kassis-adk-mcp": "./src/cli/kassis-adk-mcp.mjs",
    "./profiles/addon-coding-agent.json": "./profiles/addon-coding-agent.json",
    "./profiles/addon-coding-agent.v1.json": "./profiles/addon-coding-agent.v1.json",
    "./profiles/addon-coding-agent.v3.draft.json": "./profiles/addon-coding-agent.v3.draft.json"
  },
  "files": [
    "dist",
    "profiles"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build && node ../../scripts/pack-publish-fields.mjs apply",
    "postpack": "node ../../scripts/pack-publish-fields.mjs restore"
  },
  "dependencies": {
    "@kassis/addon-sdk": "0.1.0",
    "@kassis/addon-testkit": "0.1.0",
    "@kassis/adk-protocol": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./mandatory-contract": {
        "types": "./dist/engine/mandatoryContract.d.mts",
        "import": "./dist/engine/mandatoryContract.mjs",
        "default": "./dist/engine/mandatoryContract.mjs"
      },
      "./profiles/addon-coding-agent.json": "./profiles/addon-coding-agent.json",
      "./profiles/addon-coding-agent.v1.json": "./profiles/addon-coding-agent.v1.json",
      "./profiles/addon-coding-agent.v3.draft.json": "./profiles/addon-coding-agent.v3.draft.json"
    }
  }
}
