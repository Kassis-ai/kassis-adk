{
  "name": "@kassis/mcp-contract",
  "version": "0.1.1",
  "type": "module",
  "description": "Typed MCP tool contract shared by the host, core MCP server, and addons.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis-adk.git",
    "directory": "packages/mcp-contract"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build && node ../../tools/adk/pack-publish-fields.mjs apply",
    "postpack": "node ../../tools/adk/pack-publish-fields.mjs restore"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
