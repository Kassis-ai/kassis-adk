{
  "name": "@kassis/addon-sdk",
  "version": "1.0.0",
  "type": "module",
  "description": "Public addon contract: AddonContext types, manifest v2 schema and validator, KADK error codes.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema/addon-manifest.v2.schema.json": "./schema/addon-manifest.v2.schema.json",
    "./browser-externals.json": "./browser-externals.json",
    "./codes/kadk-codes.json": "./codes/kadk-codes.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "codes",
    "README.md",
    "browser-externals.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build && node ../../scripts/pack-publish-fields.mjs apply",
    "postpack": "node ../../scripts/pack-publish-fields.mjs restore"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./schema/addon-manifest.v2.schema.json": "./schema/addon-manifest.v2.schema.json",
      "./browser-externals.json": "./browser-externals.json",
      "./codes/kadk-codes.json": "./codes/kadk-codes.json",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
