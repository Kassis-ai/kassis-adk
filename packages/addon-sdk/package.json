{
  "name": "@kassis/addon-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Public addon contract: AddonContext types, manifest v2 schema and validator, KADK error codes.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis-adk.git",
    "directory": "packages/addon-sdk"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/addon-manifest.v2.schema.json": "./schema/addon-manifest.v2.schema.json",
    "./schema/process-pack.schema.json": "./schema/process-pack.schema.json",
    "./process-pack-kinds.json": "./process-pack-kinds.json",
    "./browser-externals.json": "./browser-externals.json",
    "./codes/kadk-codes.json": "./codes/kadk-codes.json",
    "./tier-matrix.json": "./tier-matrix.json",
    "./guardrails.json": "./guardrails.json",
    "./banned-dependencies.json": "./banned-dependencies.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "codes",
    "tier-matrix.json",
    "guardrails.json",
    "banned-dependencies.json",
    "process-pack-kinds.json",
    "README.md",
    "browser-externals.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node ../../tools/adk/pack-session.mjs begin \"npm run build && node ../../tools/adk/pack-publish-fields.mjs apply\"",
    "postpack": "node ../../tools/adk/pack-session.mjs end \"node ../../tools/adk/pack-publish-fields.mjs restore\""
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./schema/addon-manifest.v2.schema.json": "./schema/addon-manifest.v2.schema.json",
      "./schema/process-pack.schema.json": "./schema/process-pack.schema.json",
      "./process-pack-kinds.json": "./process-pack-kinds.json",
      "./browser-externals.json": "./browser-externals.json",
      "./codes/kadk-codes.json": "./codes/kadk-codes.json",
      "./tier-matrix.json": "./tier-matrix.json",
      "./guardrails.json": "./guardrails.json",
      "./banned-dependencies.json": "./banned-dependencies.json",
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
