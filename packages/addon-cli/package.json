{
  "name": "@kassis/addon-cli",
  "version": "0.1.1",
  "type": "module",
  "description": "kassis-addon command line. The host supplies the runtime; this package supplies the commands.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis-adk.git",
    "directory": "packages/addon-cli"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "kassis-addon": "./bin/kassis-addon.mjs",
    "kassis-adk-mcp": "./bin/kassis-adk-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "lib",
    "templates",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node prepack.mjs && npm run build && node ../../tools/adk/pack-publish-fields.mjs apply",
    "postpack": "node ../../tools/adk/pack-publish-fields.mjs restore"
  },
  "dependencies": {
    "@kassis/addon-testkit": "0.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "es-module-lexer": "^2.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
