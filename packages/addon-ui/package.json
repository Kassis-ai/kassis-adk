{
  "name": "@kassis/addon-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared addon slot runtime. The host and every addon UI use this one copy of the slot boundary and kill switch. This package publishes types; the host serves the runtime.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build && node ../../tools/adk/pack-publish-fields.mjs apply",
    "postpack": "node ../../tools/adk/pack-publish-fields.mjs restore"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "react": "^19.2.3"
  }
}
