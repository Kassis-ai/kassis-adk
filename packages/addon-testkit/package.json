{
  "name": "@kassis/addon-testkit",
  "version": "0.1.0",
  "type": "module",
  "description": "Assertions a coding agent uses to prove an addon pack and that source stays off the host.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kassis-ai/kassis.git",
    "directory": "packages/addon-testkit"
  },
  "dependencies": {
    "@kassis/addon-sdk": "0.1.0",
    "es-module-lexer": "^2.1.0",
    "typescript": "^5.9.3"
  },
  "main": "./src/index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs && node ../../tools/adk/pack-publish-fields.mjs apply",
    "postpack": "node ../../tools/adk/pack-publish-fields.mjs restore"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
