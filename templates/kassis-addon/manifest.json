{
  "manifestVersion": 2,
  "id": "__ADDON_ID__",
  "name": "__ADDON_NAME__",
  "version": "0.1.0",
  "publisher": "__PUBLISHER__",
  "tier": 2,
  "hostApi": "^1.0.0",
  "resources": { "memoryMb": 128 },
  "health": { "path": "/health" },
  "entrypoints": { "main": "dist/server/index.js" },
  "permissions": [{ "name": "__ADDON_ID__.view", "displayName": "View" }],
  "audit": { "actions": ["__ADDON_ID__.started"] },
  "events": {
    "publishes": [
      {
        "name": "__ADDON_ID__.started",
        "schema": "events/started.schema.json"
      }
    ]
  },
  "jobs": { "types": ["__ADDON_ID__.refresh"] },
  "prompts": { "keys": ["__ADDON_ID__.summary"] },
  "ui": { "entryFile": "index.js", "runtimeLoad": true },
  "metadata": { "description": "__ADDON_NAME__" }
}
